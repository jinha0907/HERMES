<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="100dp"
    android:background="#DFF6FF">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 상단 타이틀 -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HERMES"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="30sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- 가운데 원형 버튼 -->
        <FrameLayout
            android:id="@+id/stateButtonWrapper"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/transparent"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/imgState"
                android:layout_width="340dp"
                android:layout_height="340dp"
                android:src="@drawable/ic_cross_circle"
                android:backgroundTint="#E0E0E0"
                android:background="@drawable/ic_check_circle"
                android:layout_gravity="center"
                android:elevation="12dp"
                android:outlineProvider="background"
                android:clipToOutline="true" />
        </FrameLayout>

        <!-- 연결 상태 텍스트 -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="연결되지 않음"
            android:textColor="#444444"
            android:textSize="20sp"
            android:layout_marginBottom="30dp" />

        <!-- 하단 버튼 영역 -->
        <LinearLayout
            android:id="@+id/bottomButtonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="60dp">

            <Button
                android:id="@+id/btnManual"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="36dp"
                android:layout_marginBottom="28dp"
                android:text="직접 주소 입력하기"
                android:textSize="18sp"
                android:background="@drawable/btn_soft_gray"
                android:textColor="#222222"
                android:elevation="5dp"
                android:stateListAnimator="@animator/button_press_anim" />

            <Button
                android:id="@+id/btnOpenPermission"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginHorizontal="36dp"
                android:text="알림 접근 설정 열기"
                android:textSize="18sp"
                android:background="@drawable/btn_soft_gray"
                android:textColor="#222222"
                android:elevation="5dp"
                android:stateListAnimator="@animator/button_press_anim"
                android:layout_marginBottom="30dp"/>
        </LinearLayout>

        <!-- 수동 연결 입력창 (초기 숨김) -->
        <LinearLayout
            android:id="@+id/manualLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수동으로 연결하기"
                android:textStyle="bold"
                android:textSize="30sp"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HERMES 월패드의 주소, 아이디, 비밀번호를 입력해주세요"
                android:textColor="#555555"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/etHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="주소 Ex) tcp://192.x.x.x:1883"
                android:inputType="textUri"
                android:background="@drawable/edittext_bg"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="선택(아이디)"
                android:inputType="text"
                android:background="@drawable/edittext_bg"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="선택(비밀번호)"
                android:inputType="textPassword"
                android:background="@drawable/edittext_bg"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="연결하기"
                android:textSize="17sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1E90FF"
                android:elevation="5dp"
                android:stateListAnimator="@animator/button_press_anim" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
